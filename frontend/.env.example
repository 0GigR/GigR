VITE_API_URL=http://localhost:8000/api/v1
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
VITE_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_cloudinary_unsigned_preset
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA # Use dummy for testing, real key for production

# ── Agent OS Feature Flags (all default to true, set false to disable) ──
# VITE_FEATURE_AGENT_MULTI_TURN=true
# VITE_FEATURE_AGENT_REASONING_VISIBLE=true
# VITE_FEATURE_AGENT_MAP_RESULTS=true
# VITE_FEATURE_AGENT_PROACTIVE_SURFACE=true
# VITE_FEATURE_AGENT_COMMAND_PALETTE=true
# VITE_FEATURE_AGENT_PREMIUM=false

# Which payment rail this build uses: solana (the original app, default) or paypal.
# Sent to the backend as X-Payment-Rail; the backend has no rail setting of its own.
# Deploy two frontends from this repo to offer both, against the same backend.
VITE_PAYMENT_RAIL=solana
